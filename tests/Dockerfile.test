# Test container for S0PCM Reader
FROM python:3.14-alpine@sha256:f6a589d43c42b9e7f7dc67a12d37132491f362859a5d750607710cc56da3bc72

RUN apk add --no-cache \
    gcc \
    musl-dev \
    linux-headers

WORKDIR /workspace

COPY --from=ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b /uv /uvx /bin/

# Install all deps (prod + test group)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-emit-project --no-hashes --group test | \
    uv pip install --system --no-cache -r -

COPY rootfs/usr/src/ ./rootfs/usr/src/
COPY tests/ ./tests/

# Set Python path to find the module
ENV PYTHONPATH=/workspace
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Default command runs linting then tests
CMD ["sh", "-c", "ruff check . && ruff format --check . && pytest tests/ -v --tb=short"]
