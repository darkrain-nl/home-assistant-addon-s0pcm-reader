# Test container for S0PCM Reader
# This container provides an isolated environment for running tests

# 3.14-alpine
FROM python:3.14-alpine@sha256:26730869004e2b9c4b9ad09cab8625e81d256d1ce97e72df5520e806b1709f92

# Install system dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    linux-headers

# Set working directory
WORKDIR /workspace

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.11.29@sha256:eb2843a1e56fd9e30c7276ce1a52cba86e64c7b385f5e3279a0e08e02dd058fc /uv /uvx /bin/

# Install all deps (prod + test group)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-emit-project --no-hashes --group test | \
    uv pip install --system --no-cache -r -

# Copy source code and tests
COPY rootfs/usr/src/ ./rootfs/usr/src/
COPY tests/ ./tests/

# Set Python path to find the module
ENV PYTHONPATH=/workspace
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Default command runs linting then tests
CMD ["sh", "-c", "ruff check . && ruff format --check . && pytest tests/ -v --tb=short"]
