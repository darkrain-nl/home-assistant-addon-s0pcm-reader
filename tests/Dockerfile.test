# Test container for S0PCM Reader
# This container provides an isolated environment for running tests

# 3.14-alpine
FROM python:3.14-alpine@sha256:05b2b8b732ecd268fee8727a369f936f022d1321b59befd13c30ede22769dcdc

# Install system dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    linux-headers

# Set working directory
WORKDIR /workspace

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.12.9@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff /uv /uvx /bin/

# Install all deps (prod + test group)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-emit-project --no-hashes --group test | \
    uv pip install --system --no-cache -r -

# Copy source code and tests
COPY rootfs/usr/src/ ./rootfs/usr/src/
COPY tests/ ./tests/

# Set Python path to find the module
ENV PYTHONPATH=/workspace
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Default command runs linting then tests
CMD ["sh", "-c", "ruff check . && ruff format --check . && pytest tests/ -v --tb=short"]
