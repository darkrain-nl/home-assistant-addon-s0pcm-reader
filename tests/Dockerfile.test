# Test container for S0PCM Reader
# This container provides an isolated environment for running tests

# 3.14-alpine
FROM python:3.14-alpine@sha256:f6a589d43c42b9e7f7dc67a12d37132491f362859a5d750607710cc56da3bc72

# Install system dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    linux-headers

# Set working directory
WORKDIR /workspace

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168 /uv /uvx /bin/

# Install all deps (prod + test group)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-emit-project --no-hashes --group test | \
    uv pip install --system --no-cache -r -

# Copy source code and tests
COPY rootfs/usr/src/ ./rootfs/usr/src/
COPY tests/ ./tests/

# Set Python path to find the module
ENV PYTHONPATH=/workspace
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Default command runs linting then tests
CMD ["sh", "-c", "ruff check . && ruff format --check . && pytest tests/ -v --tb=short"]
